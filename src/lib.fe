// Last Wei: deterministic proportional ETH allocation quotes for four recipients.
// This contract computes integer wei payouts. It does not custody or transfer ETH.

use std::abi::sol
use std::evm::Wei

const MAX_TOTAL_WEIGHT: u256 = 1_000_000_000_000_000_000

msg SplitterMsg {
    #[selector = sol("quote(uint256,uint256[4])")]
    Quote { amount: Wei, weights: [u256; 4] } -> [u256; 4],
}

// Largest-remainder allocation. Floor each exact share, then distribute the
// fewer-than-four leftover wei to the largest fractional remainders. Ties go
// to the lower input index. Zero-weight recipients are never selected.
fn allocate(amount: Wei, weights: [u256; 4]) -> [u256; 4] {
    var total_weight: u256 = 0
    for weight in weights {
        assert!(weight <= MAX_TOTAL_WEIGHT, "Weight exceeds limit")
        assert!(
            total_weight <= MAX_TOTAL_WEIGHT - weight,
            "Total weight exceeds limit",
        )
        total_weight += weight
    }
    assert!(total_weight > 0, "At least one weight is required")

    let amount_wei = amount.as_wei()
    let amount_mod_total = amount_wei % total_weight
    var shares: [u256; 4] = [0; 4]
    var remainders: [u256; 4] = [0; 4]
    var assigned: [bool; 4] = [false; 4]
    var allocated: u256 = 0

    for (i, weight) in weights.enumerate() {
        if weight > 0 {
            let base = amount.mul_div(numerator: weight, denominator: total_weight).as_wei()
            shares[i] = base
            allocated += base
            // (amount * weight) mod total == ((amount mod total) * weight) mod total.
            // Both factors are at most MAX_TOTAL_WEIGHT, so this product fits u256.
            remainders[i] = (amount_mod_total * weight) % total_weight
        }
    }

    var remaining = amount_wei - allocated
    while remaining > 0 {
        var best_index: usize = 4
        var best_remainder: u256 = 0
        for (i, weight) in weights.enumerate() {
            if weight > 0 && !assigned[i] {
                if best_index == 4 || remainders[i] > best_remainder {
                    best_index = i
                    best_remainder = remainders[i]
                }
            }
        }
        assert!(best_index < 4, "No eligible recipient for remainder")
        shares[best_index] += 1
        assigned[best_index] = true
        remaining -= 1
    }

    shares
}

pub contract LastWeiSplitter {
    recv SplitterMsg {
        Quote { amount, weights } -> [u256; 4] {
            allocate(amount: amount, weights: weights)
        }
    }
}
